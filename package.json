{
  "name": "finance-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "package:desktop": "vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.simonandson.invoicetracker",
    "productName": "Simon & Son Invoice Ledger",
    "directories": {
      "output": "C:\\Users\\acer\\Documents\\finance_tracker\\dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "executableName": "Simon & Son Invoice Ledger"
    },
    "asar": true
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jspdf": "^3.0.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "bytenode": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.6.0",
    "vite": "^5.4.14"
  }
}