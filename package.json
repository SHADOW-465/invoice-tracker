{
  "name": "finance-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "package:desktop": "vite build && npx @electron/packager . \"Simon & Son Invoice Ledger\" --platform=win32 --arch=x64 --out=dist-desktop --overwrite"
  },
  "build": {
    "appId": "com.simonandson.invoicetracker",
    "productName": "Simon & Son Invoice Ledger",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jspdf": "^3.0.4",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.14"
  }
}
